{
  "rules": {
    "visits": {
      ".read": true,
      "$day": {
        "$name": {
          ".write": "$day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && $name.matches(/^[a-z0-9]{1,24}$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    }
  }
}
