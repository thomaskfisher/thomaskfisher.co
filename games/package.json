    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
